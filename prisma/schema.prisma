generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cosecha {
  id                Int                   @id @default(autoincrement())
  fecha             DateTime
  kilosCosechados   Float
  lotes             String
  totalHectareas    Float
  tipoCosecha       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  varietal          String?
  observacion       String?
  cosechaLotes      CosechaLote[]
  CosechaTrabajador CosechaTrabajador[]
  procesos          ProcesoTrazabilidad[]
  lotesFisicos      CosechaLoteFisico[]
}

// ── Catálogo de lotes físicos (cuarteles dentro de un fundo) ──
// Ej: FSC-1..45, FSS-1..36, FDS-1..7. Editable desde la app.
model Fundo {
  id           Int          @id @default(autoincrement())
  codigo       String       @unique // FSC, FSS, FDS
  nombre       String?
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lotesFisicos LoteFisico[]
}

model LoteFisico {
  id        Int                 @id @default(autoincrement())
  codigo    String              @unique // FSC-1
  numero    Int
  fundoId   Int
  hectareas Float?
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  fundo     Fundo               @relation(fields: [fundoId], references: [id])
  cosechas  CosechaLoteFisico[]

  @@unique([fundoId, numero])
}

// Lotes físicos de origen de una cosecha
model CosechaLoteFisico {
  id           Int        @id @default(autoincrement())
  cosechaId    Int
  loteFisicoId Int
  createdAt    DateTime   @default(now())
  cosecha      Cosecha    @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  loteFisico   LoteFisico @relation(fields: [loteFisicoId], references: [id])

  @@unique([cosechaId, loteFisicoId])
}

model Lote {
  id                  Int                   @id @default(autoincrement())
  codigo              String                @unique
  nombre              String?
  hectareas           Float?
  ubicacion           String?
  observacion         String?
  activo              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  estado              EstadoLote            @default(EN_PROCESO)
  kilosIniciales      Float?
  kilosActuales       Float?
  saldoTemporal       Float?
  tipoCodigo          TipoCodigoLote        @default(COMERCIAL)
  gradosBrix          Float?
  ordenTrillaId       String?
  cosechaLotes        CosechaLote[]
  empaques            Empaque[]
  ordenTrilla         OrdenTrilla?          @relation(fields: [ordenTrillaId], references: [id])
  ProcesoTrazabilidad ProcesoTrazabilidad[]
  secados             Secado[]
  secadoLotes         SecadoLote[]
  ordenTrillaLotes    OrdenTrillaLote[]
}

model CosechaLote {
  id          Int      @id @default(autoincrement())
  cosechaId   Int
  loteId      Int
  // Kilos parciales tomados de esta cosecha para el lote de proceso
  kilosUsados Float    @default(0)
  createdAt   DateTime @default(now())
  cosecha     Cosecha  @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  lote        Lote     @relation(fields: [loteId], references: [id])

  @@unique([cosechaId, loteId])
}

model Usuario {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  password     String
  nombre       String
  rol          String         @default("ADMIN")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  RefreshToken RefreshToken[]
}

model RefreshToken {
  id        String    @id
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  Usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([expiresAt])
  @@index([usuarioId])
}

model ProcesoTrazabilidad {
  id                 Int          @id @default(autoincrement())
  fecha              DateTime
  etapa              String?
  kilosIngresados    Float
  kilosResultantes   Float?
  cosechaId          Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  loteId             Int?
  codigo             String       @unique
  duracionHoras      Float
  fechaInicio        DateTime?
  fechaFin           DateTime?
  tipoProceso        TipoProceso?
  gradosBrix         Float?
  nivelPh            Float?
  tempMaxima         Float?
  tempMinima         Float?
  tanqueFermentacion String?
  inicioFermentacion DateTime?
  finFermentacion    DateTime?
  fueDespulpado      Boolean?
  fueLavado          Boolean?
  cosecha            Cosecha?     @relation(fields: [cosechaId], references: [id])
  Lote               Lote?        @relation(fields: [loteId], references: [id])
}

model Trabajador {
  id                Int                 @id @default(autoincrement())
  nombres           String
  dni               String              @unique
  rol               String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activo            Boolean             @default(true)
  apellidos         String?
  telefono          String?
  CosechaTrabajador CosechaTrabajador[]
}

model Cliente {
  id              Int      @id @default(autoincrement())
  nombre          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activo          Boolean  @default(true)
  direccion       String?
  dniRut          String   @unique
  email           String?
  personaJuridica Boolean  @default(false)
  telefono        String?
  ventas          Venta[]
}

model CosechaTrabajador {
  id             Int        @id @default(autoincrement())
  cosechaId      Int
  trabajadorId   Int
  kilosAsignados Float?
  createdAt      DateTime   @default(now())
  Cosecha        Cosecha    @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  Trabajador     Trabajador @relation(fields: [trabajadorId], references: [id])

  @@unique([cosechaId, trabajadorId])
}

model Secado {
  id               Int             @id @default(autoincrement())
  codigo           String?         @unique
  loteId           Int
  fechaInicio      DateTime
  fechaFin         DateTime?
  kilosIngresados  Float
  kilosResultantes Float
  merma            Float
  observaciones    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  perfilProceso    PerfilSecado?
  secadora         String?
  tempMinima       Float?
  tempMaxima       Float?
  lote             Lote            @relation(fields: [loteId], references: [id])
  empaques         Empaque[]
  secadoLotes      SecadoLote[]
  empaqueSecados   EmpaqueSecado[]
}

// Lotes húmedos que alimentan un proceso de secado (con kilos parciales)
model SecadoLote {
  id          Int      @id @default(autoincrement())
  secadoId    Int
  loteId      Int
  kilosUsados Float
  createdAt   DateTime @default(now())
  secado      Secado   @relation(fields: [secadoId], references: [id], onDelete: Cascade)
  lote        Lote     @relation(fields: [loteId], references: [id])

  @@unique([secadoId, loteId])
}

model Empaque {
  id               Int             @id @default(autoincrement())
  codigo           String?         @unique
  loteId           Int
  secadoId         Int?
  tipoEmpaque      String?
  cantidadEmpaques Int?
  rendimiento      Float?
  fechaInicio      DateTime
  fechaFin         DateTime?
  kilosIngresados  Float
  kilosResultantes Float
  merma            Float
  observaciones    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  humedad          Float?
  actividadAgua    Float?
  puntajeSca       Float?
  perfilSensorial  String?
  fueCatado        Boolean?
  lote             Lote            @relation(fields: [loteId], references: [id])
  secado           Secado?         @relation(fields: [secadoId], references: [id])
  empaqueSecados   EmpaqueSecado[]
}

// Códigos de secado agrupados en una entrada de Almacén Pergamino
model EmpaqueSecado {
  id          Int      @id @default(autoincrement())
  empaqueId   Int
  secadoId    Int
  kilosUsados Float?
  createdAt   DateTime @default(now())
  empaque     Empaque  @relation(fields: [empaqueId], references: [id], onDelete: Cascade)
  secado      Secado   @relation(fields: [secadoId], references: [id])

  @@unique([empaqueId, secadoId])
}

model OrdenTrilla {
  id              String            @id @default(uuid())
  codigoTrilla    String            @unique
  numeroGuia      String?
  fechaDespacho   DateTime
  fechaIngreso    DateTime?
  calidad         String?
  tipoSaco        String?
  sacosEnviados   Int?
  kilosEnviados   Float
  kilosNetos      Float?
  exportable      Float?
  recuperado      Float?
  malla13         Float?
  segundaBuena    Float?
  segundaMala     Float?
  sucioEscojo     Float?
  cisco           Float?
  descarteMaquina Float?
  cascarilla      Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lotes           Lote[]
  ventas          Venta[]
  ordenLotes      OrdenTrillaLote[]
}

// Descuento manual de kilos por lote en una orden de trilla
model OrdenTrillaLote {
  id               Int         @id @default(autoincrement())
  ordenTrillaId    String
  loteId           Int
  kilosDescontados Float
  sacos            Int?
  createdAt        DateTime    @default(now())
  ordenTrilla      OrdenTrilla @relation(fields: [ordenTrillaId], references: [id], onDelete: Cascade)
  lote             Lote        @relation(fields: [loteId], references: [id])

  @@unique([ordenTrillaId, loteId])
}

model Venta {
  id                 String      @id @default(uuid())
  fechaVenta         DateTime    @default(now())
  producto           String
  kilosVendidos      Float
  presentacionSacos  String
  precioVentaKilo    Float
  precioCompra       Float?
  numeroFactura      String?
  numeroGuiaRemision String?
  fincaOrigen        String?
  clienteId          Int
  ordenTrillaId      String
  cliente            Cliente     @relation(fields: [clienteId], references: [id])
  ordenTrilla        OrdenTrilla @relation(fields: [ordenTrillaId], references: [id])
}

enum EstadoLote {
  EN_PROCESO
  EN_SECADO
  EN_ALMACEN
  TRILLADO
  VENDIDO
  CERRADO
  INACTIVO
}

enum TipoCodigoLote {
  COMERCIAL
  ESPECIAL
  PERSONALIZADO
}

enum PerfilSecado {
  HONEY
  NATURAL
  LAVADO
}

enum TipoProceso {
  OXIDACION_CEREZA
  OXIDACION_MUCILAGO
  ANAEROBICO_CEREZA
  ANAEROBICO_MUCILAGO
}
