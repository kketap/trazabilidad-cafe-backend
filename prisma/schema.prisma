generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cosecha {
  id                Int                   @id @default(autoincrement())
  fecha             DateTime
  kilosCosechados   Float
  lotes             String
  totalHectareas    Float
  tipoCosecha       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  varietal          String?
  observacion       String?
  cosechaLotes      CosechaLote[]
  lotesFisicos      CosechaLoteFisico[]
  CosechaTrabajador CosechaTrabajador[]
  procesos          ProcesoTrazabilidad[]
}

model Fundo {
  id           Int          @id @default(autoincrement())
  codigo       String       @unique
  nombre       String?
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lotesFisicos LoteFisico[]
}

model LoteFisico {
  id        Int                 @id @default(autoincrement())
  codigo    String              @unique
  numero    Int
  fundoId   Int
  hectareas Float?
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  cosechas  CosechaLoteFisico[]
  fundo     Fundo               @relation(fields: [fundoId], references: [id])

  @@unique([fundoId, numero])
}

model CosechaLoteFisico {
  id           Int        @id @default(autoincrement())
  cosechaId    Int
  loteFisicoId Int
  createdAt    DateTime   @default(now())
  cosecha      Cosecha    @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  loteFisico   LoteFisico @relation(fields: [loteFisicoId], references: [id])

  @@unique([cosechaId, loteFisicoId])
}

model Lote {
  id                  Int                   @id @default(autoincrement())
  codigo              String                @unique
  nombre              String?
  hectareas           Float?
  ubicacion           String?
  observacion         String?
  activo              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  estado              EstadoLote            @default(EN_PROCESO)
  kilosActuales       Float?
  kilosIniciales      Float?
  saldoTemporal       Float?
  tipoCodigo          TipoCodigoLote        @default(COMERCIAL)
  ordenTrillaId       String?
  gradosBrix          Float?
  cosechaLotes        CosechaLote[]
  empaques            Empaque[]
  ordenTrilla         OrdenTrilla?          @relation(fields: [ordenTrillaId], references: [id])
  ordenTrillaLotes    OrdenTrillaLote[]
  ProcesoTrazabilidad ProcesoTrazabilidad[]
  secados             Secado[]
  secadoLotes         SecadoLote[]
}

model CosechaLote {
  id          Int      @id @default(autoincrement())
  cosechaId   Int
  loteId      Int
  createdAt   DateTime @default(now())
  kilosUsados Float    @default(0)
  cosecha     Cosecha  @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  lote        Lote     @relation(fields: [loteId], references: [id])

  @@unique([cosechaId, loteId])
}

model Usuario {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  nombre        String
  rol           String         @default("ADMIN")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([usuarioId])
}

model ProcesoTrazabilidad {
  id                 Int          @id @default(autoincrement())
  fecha              DateTime
  etapa              String?
  kilosIngresados    Float
  cosechaId          Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  loteId             Int?
  codigo             String       @unique
  duracionHoras      Float
  fechaInicio        DateTime?
  fechaFin           DateTime?
  tipoProceso        TipoProceso?
  finFermentacion    DateTime?
  fueDespulpado      Boolean?
  fueLavado          Boolean?
  gradosBrix         Float?
  inicioFermentacion DateTime?
  nivelPh            Float?
  tanqueFermentacion String?
  tempMaxima         Float?
  tempMinima         Float?
  kilosResultantes   Float?
  cosecha            Cosecha?     @relation(fields: [cosechaId], references: [id])
  Lote               Lote?        @relation(fields: [loteId], references: [id])
}

model Trabajador {
  id                Int                 @id @default(autoincrement())
  nombres           String
  dni               String              @unique
  rol               String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activo            Boolean             @default(true)
  apellidos         String?
  telefono          String?
  CosechaTrabajador CosechaTrabajador[]
}

model Cliente {
  id              Int      @id @default(autoincrement())
  nombre          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activo          Boolean  @default(true)
  direccion       String?
  dniRut          String   @unique
  email           String?
  personaJuridica Boolean  @default(false)
  telefono        String?
  ventas          Venta[]
}

model CosechaTrabajador {
  id             Int        @id @default(autoincrement())
  cosechaId      Int
  trabajadorId   Int
  kilosAsignados Float?
  createdAt      DateTime   @default(now())
  Cosecha        Cosecha    @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  Trabajador     Trabajador @relation(fields: [trabajadorId], references: [id])

  @@unique([cosechaId, trabajadorId])
}

model Secado {
  id               Int             @id @default(autoincrement())
  loteId           Int
  fechaInicio      DateTime
  fechaFin         DateTime?
  kilosIngresados  Float
  kilosResultantes Float
  merma            Float
  observaciones    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  perfilProceso    PerfilSecado?
  secadora         String?
  tempMaxima       Float?
  tempMinima       Float?
  codigo           String?         @unique
  empaques         Empaque[]
  empaqueSecados   EmpaqueSecado[]
  lote             Lote            @relation(fields: [loteId], references: [id])
  secadoLotes      SecadoLote[]
}

model SecadoLote {
  id          Int      @id @default(autoincrement())
  secadoId    Int
  loteId      Int
  kilosUsados Float
  createdAt   DateTime @default(now())
  lote        Lote     @relation(fields: [loteId], references: [id])
  secado      Secado   @relation(fields: [secadoId], references: [id], onDelete: Cascade)

  @@unique([secadoId, loteId])
}

model Empaque {
  id               Int             @id @default(autoincrement())
  loteId           Int
  fechaInicio      DateTime
  fechaFin         DateTime?
  kilosIngresados  Float
  kilosResultantes Float
  merma            Float
  observaciones    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  actividadAgua    Float?
  fueCatado        Boolean?
  humedad          Float?
  perfilSensorial  String?
  puntajeSca       Float?
  cantidadEmpaques Int?
  rendimiento      Float?
  secadoId         Int?
  tipoEmpaque      String?
  codigo           String?         @unique
  lote             Lote            @relation(fields: [loteId], references: [id])
  secado           Secado?         @relation(fields: [secadoId], references: [id])
  empaqueSecados   EmpaqueSecado[]
}

model EmpaqueSecado {
  id          Int      @id @default(autoincrement())
  empaqueId   Int
  secadoId    Int
  kilosUsados Float?
  createdAt   DateTime @default(now())
  empaque     Empaque  @relation(fields: [empaqueId], references: [id], onDelete: Cascade)
  secado      Secado   @relation(fields: [secadoId], references: [id])

  @@unique([empaqueId, secadoId])
}

model OrdenTrilla {
  id              String            @id @default(uuid())
  codigoTrilla    String            @unique
  fechaDespacho   DateTime
  fechaIngreso    DateTime?
  calidad         String?
  tipoSaco        String?
  kilosEnviados   Float
  kilosNetos      Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  cascarilla      Float?
  cisco           Float?
  descarteMaquina Float?
  exportable      Float?
  malla13         Float?
  numeroGuia      String?
  recuperado      Float?
  segundaBuena    Float?
  segundaMala     Float?
  sucioEscojo     Float?
  sacosEnviados   Int?
  lotes           Lote[]
  ordenLotes      OrdenTrillaLote[]
  ventas          Venta[]
}

model OrdenTrillaLote {
  id               Int         @id @default(autoincrement())
  ordenTrillaId    String
  loteId           Int
  kilosDescontados Float
  sacos            Int?
  createdAt        DateTime    @default(now())
  lote             Lote        @relation(fields: [loteId], references: [id])
  ordenTrilla      OrdenTrilla @relation(fields: [ordenTrillaId], references: [id], onDelete: Cascade)

  @@unique([ordenTrillaId, loteId])
}

model Venta {
  id                 String      @id @default(uuid())
  fechaVenta         DateTime    @default(now())
  producto           String
  kilosVendidos      Float
  presentacionSacos  String
  precioVentaKilo    Float
  precioCompra       Float?
  numeroFactura      String?
  numeroGuiaRemision String?
  fincaOrigen        String?
  clienteId          Int
  ordenTrillaId      String
  cliente            Cliente     @relation(fields: [clienteId], references: [id])
  ordenTrilla        OrdenTrilla @relation(fields: [ordenTrillaId], references: [id])
}

enum EstadoLote {
  EN_PROCESO
  EN_SECADO
  EN_ALMACEN
  TRILLADO
  VENDIDO
  CERRADO
  INACTIVO
}

enum TipoCodigoLote {
  COMERCIAL
  ESPECIAL
  PERSONALIZADO
}

enum PerfilSecado {
  HONEY
  NATURAL
  LAVADO
}

enum TipoProceso {
  OXIDACION_CEREZA
  OXIDACION_MUCILAGO
  ANAEROBICO_CEREZA
  ANAEROBICO_MUCILAGO
}
