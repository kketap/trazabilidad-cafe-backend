generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cosecha {
  id                Int                   @id @default(autoincrement())
  fecha             DateTime
  kilosCosechados   Float
  lotes             String
  totalHectareas    Float
  tipoCosecha       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  varietal          String?
  cosechaLotes      CosechaLote[]
  CosechaTrabajador CosechaTrabajador[]
  procesos          ProcesoTrazabilidad[]
}

model Lote {
  id                  Int                   @id @default(autoincrement())
  codigo              String                @unique
  nombre              String?
  hectareas           Float?
  ubicacion           String?
  observacion         String?
  activo              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  estado              EstadoLote            @default(EN_PROCESO)
  kilosIniciales      Float?
  kilosActuales       Float?
  saldoTemporal       Float?
  tipoCodigo          TipoCodigoLote        @default(COMERCIAL)
  gradosBrix          Float?
  ordenTrillaId       String?
  cosechaLotes        CosechaLote[]
  empaques            Empaque[]
  ordenTrilla         OrdenTrilla?          @relation(fields: [ordenTrillaId], references: [id])
  ProcesoTrazabilidad ProcesoTrazabilidad[]
  secados             Secado[]
}

model CosechaLote {
  id        Int      @id @default(autoincrement())
  cosechaId Int
  loteId    Int
  createdAt DateTime @default(now())
  cosecha   Cosecha  @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  lote      Lote     @relation(fields: [loteId], references: [id])

  @@unique([cosechaId, loteId])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  rol       String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcesoTrazabilidad {
  id                 Int          @id @default(autoincrement())
  fecha              DateTime
  etapa              String?
  kilosIngresados    Float
  cosechaId          Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  loteId             Int?
  codigo             String       @unique
  duracionHoras      Float
  fechaInicio        DateTime?
  fechaFin           DateTime?
  tipoProceso        TipoProceso?
  gradosBrix         Float?
  nivelPh            Float?
  tempMaxima         Float?
  tempMinima         Float?
  tanqueFermentacion String?
  inicioFermentacion DateTime?
  finFermentacion    DateTime?
  fueDespulpado      Boolean?
  fueLavado          Boolean?
  cosecha            Cosecha?     @relation(fields: [cosechaId], references: [id])
  Lote               Lote?        @relation(fields: [loteId], references: [id])
}

model Trabajador {
  id                Int                 @id @default(autoincrement())
  nombres           String
  dni               String              @unique
  rol               String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activo            Boolean             @default(true)
  apellidos         String?
  telefono          String?
  CosechaTrabajador CosechaTrabajador[]
}

model Cliente {
  id              Int      @id @default(autoincrement())
  nombre          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activo          Boolean  @default(true)
  direccion       String?
  dniRut          String   @unique
  email           String?
  personaJuridica Boolean  @default(false)
  telefono        String?
  ventas          Venta[]
}

model CosechaTrabajador {
  id             Int        @id @default(autoincrement())
  cosechaId      Int
  trabajadorId   Int
  kilosAsignados Float?
  createdAt      DateTime   @default(now())
  Cosecha        Cosecha    @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  Trabajador     Trabajador @relation(fields: [trabajadorId], references: [id])

  @@unique([cosechaId, trabajadorId])
}

model Secado {
  id               Int           @id @default(autoincrement())
  codigo           String?       @unique
  loteId           Int
  fechaInicio      DateTime
  fechaFin         DateTime?
  kilosIngresados  Float
  kilosResultantes Float
  merma            Float
  observaciones    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  perfilProceso    PerfilSecado?
  secadora         String?
  tempMinima       Float?
  tempMaxima       Float?
  lote             Lote          @relation(fields: [loteId], references: [id])
  empaques         Empaque[]
}

model Empaque {
  id               Int       @id @default(autoincrement())
  loteId           Int
  secadoId         Int?
  tipoEmpaque      String?
  cantidadEmpaques Int?
  rendimiento      Float?
  fechaInicio      DateTime
  fechaFin         DateTime?
  kilosIngresados  Float
  kilosResultantes Float
  merma            Float
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  humedad          Float?
  actividadAgua    Float?
  puntajeSca       Float?
  perfilSensorial  String?
  fueCatado        Boolean?
  lote             Lote      @relation(fields: [loteId], references: [id])
  secado           Secado?   @relation(fields: [secadoId], references: [id])
}

model OrdenTrilla {
  id              String    @id @default(uuid())
  codigoTrilla    String    @unique
  numeroGuia      String?
  fechaDespacho   DateTime
  fechaIngreso    DateTime?
  calidad         String?
  tipoSaco        String?
  sacosEnviados   Int?
  kilosEnviados   Float
  kilosNetos      Float?
  exportable      Float?
  recuperado      Float?
  malla13         Float?
  segundaBuena    Float?
  segundaMala     Float?
  sucioEscojo     Float?
  cisco           Float?
  descarteMaquina Float?
  cascarilla      Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lotes           Lote[]
  ventas          Venta[]
}

model Venta {
  id                 String      @id @default(uuid())
  fechaVenta         DateTime    @default(now())
  producto           String
  kilosVendidos      Float
  presentacionSacos  String
  precioVentaKilo    Float
  precioCompra       Float?
  numeroFactura      String?
  numeroGuiaRemision String?
  fincaOrigen        String?
  clienteId          Int
  ordenTrillaId      String
  cliente            Cliente     @relation(fields: [clienteId], references: [id])
  ordenTrilla        OrdenTrilla @relation(fields: [ordenTrillaId], references: [id])
}

enum EstadoLote {
  EN_PROCESO
  EN_SECADO
  EN_ALMACEN
  TRILLADO
  VENDIDO
  CERRADO
  INACTIVO
}

enum TipoCodigoLote {
  COMERCIAL
  ESPECIAL
  PERSONALIZADO
}

enum PerfilSecado {
  HONEY
  NATURAL
  LAVADO
}

enum TipoProceso {
  OXIDACION_CEREZA
  OXIDACION_MUCILAGO
  ANAEROBICO_CEREZA
  ANAEROBICO_MUCILAGO
}
